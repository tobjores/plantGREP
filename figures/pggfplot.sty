%%% set up colormaps
\def\pggf@make@colormap#1,#2\relax{%
	\pgfmathparse{#1 < 0 && #2 > 0}%
	\ifnum1=\pgfmathresult\relax%
		\pgfplotscreatecolormap{pggf 3 colormap}{color(#1) = (pggf 3 colormap min) color(0) = (pggf 3 colormap mid) color(#2) = (pggf 3 colormap max)}%
	\else%
		\pgfplotscreatecolormap{pggf 3 colormap}{color(#1) = (pggf 3 colormap min) color(#2) = (pggf 3 colormap max)}%
	\fi%
}

\definecolor{pggf 3 colormap min}{HTML}{4876FF}
\colorlet{pggf 3 colormap mid}{white}
\definecolor{pggf 3 colormap max}{HTML}{FF6A6A}

\pgfplotscreatecolormap{pggf 3 colormap}{color(-.5) = (pggf 3 colormap min) color(0) = (pggf 3 colormap mid) color(.5) = (pggf 3 colormap max)}

%%% process dendrogram coordinates
\def\pggf@dendro@parsecoord{\@ifnextchar l\pggf@dendro@parsecoord@l\pggf@dendro@parsecoord@c}
\def\pggf@dendro@parsecoord@l#1,#2\relax{%
	\ifnum0=#2\relax%
		\path[dendrogram@x, dendrogram@x@connector] (pggf@x#1) -- (dendrogram bottom -| pggf@x#1) coordinate (pggf@#1);%
	\else%
		\path[dendrogram@y, dendrogram@y@connector] (pggf@y#1) -- (dendrogram bottom |- pggf@y#1) coordinate (pggf@#1);%
	\fi%
	
}
\def\pggf@dendro@parsecoord@c#1,#2\relax{}


%%% main plot command
% use: \pggf_<plot type>(<options>)
% parentheses are required but can be empty
\def\pggf_#1(#2){
	\ifcsname pggf@#1\endcsname % test if a command for <plot type> exists
		\advance\pggf@plotID by1\relax
		\def\pggf@plottype{#1}
		\expandafter\edef\csname pggf@data@\the\pggf@plotID\endcsname{\pggf@data}
		\def\pggf@includeplotfacets{}
		\def\pggf@skipplotfacets{}
		% set plot options
		\pggf@plot@set{\pggf@plottype}{\the\pggf@plotID}{\pggf@plottype_defaults/.try}
		\pggf@plot@set{\pggf@plottype}{\the\pggf@plotID}{#2}
		% split data file (except if <plot type> is 'annotate')
		\def\pggf@tmp{annotate}
		\ifx\pggf@plottype\pggf@tmp\else
			\directlua{pggf_data_\pggf@plottype_\the\pggf@plotID = pggfplot.splitTable('\csname pggf@data@\the\pggf@plotID\endcsname_\pggf@plottype.tsv')}
			% if <plot type> is 'violin', also split the corresponding boxplot file
			\def\pggf@tmp{violin}
			\ifx\pggf@plottype\pggf@tmp
				\directlua{pggf_data_boxplot_\the\pggf@plotID = pggfplot.splitTable('\csname pggf@data@\the\pggf@plotID\endcsname_boxplot.tsv')}
			\fi
		\fi
		% skip plots
		\if\relax\pggf@skipplotfacets\relax\else
			\expandafter\pgfplotsinvokeforeach\expandafter{\pggf@skipplotfacets}{
				\pgfplotsset{
					facet ##1/.append style/.expanded = {
						execute at begin axis/.prefix = {
							\noexpand\pggf@skip@plot{\the\pggf@plotID}
						}
					}
				}
			}
		\fi
		% add plot command
		\if\relax\pggf@includeplotfacets\relax
			\pgfplotsset{
				every facet/.append style/.expanded  = {
					execute at begin axis/.append = {
						\noexpand\csname pggf@\pggf@plottype\endcsname{\the\pggf@plotID}
					}
				}
			}
		\else
			\expandafter\pgfplotsinvokeforeach\expandafter{\pggf@includeplotfacets}{
				\pgfplotsset{
					facet ##1/.append style/.expanded = {
						execute at begin axis/.append = {
							\noexpand\csname pggf@\pggf@plottype\endcsname{\the\pggf@plotID}
						}
					}
				}
			}
		\fi
	\else % error if <plot type> is unknown
		\PackageError{pggfplot}{Unknown plot type: \string\pggf_#1}{}
	\fi
}

