\newcommand{\pggf@coltitle}[1]{
	\node[
		/pggf/every col title,
		node font = \pggf@coltitlefont,
		font/.expand once = {\tikz@textfont\pggf@coltitleheightrule}
	] at (0.5, 1) {\pggf@coltitletypeset{#1}};
 % test if the title is too wide or too high
	\ifpggf@detectoverfull
		\pgfpointdiff{\pgfpointanchor{col title}{south west}}{\pgfpointanchor{col title}{north east}}
		\pgfmathsetlength{\pggf@tmplen}{\pgf@x - \pgflinewidth - \pggf@scalewidth * \pggf@plotwidth}
		\ifdim0.0001pt<\pggf@tmplen\relax
			\pggf@warning{Overfull \string\hbox\space (\the\pggf@tmplen\space too wide) in pggfplot col title "#1"}
		\fi
		\pggf@coltitlefont\pgfmathsetlength{\pggf@tmplen}{\pgf@y - \pgflinewidth - (\pggf@coltitlelines - .15) * \baselineskip - 2 * \pgfkeysvalueof{/pgf/inner ysep}}
		\ifdim0.0001pt<\pggf@tmplen\relax
			\pggf@warning{Overfull \string\vbox\space (\the\pggf@tmplen\space too high) in pggfplot col title "#1". Increase `col title lines`}
		\fi
	\fi
}

\newcommand{\pggf@rowtitle}[1]{
	\node[
		/pggf/every row title,
		node font/.expand once =  \pggf@rowtitlefont,
		font/.expand once = {\tikz@textfont\pggf@rowtitleheightrule}
	] at (1, 0.5) {\pggf@rowtitletypeset{#1}};
 % test if the title is too wide or too high
	\ifpggf@detectoverfull
		\pgfpointdiff{\pgfpointanchor{row title}{south east}}{\pgfpointanchor{row title}{north west}}
		\pgfmathsetlength{\pggf@tmplen}{\pgf@y - \pgflinewidth - \pggf@scaleheight * \pggf@plotheight}
		\ifdim0.0001pt<\pggf@tmplen\relax
			\pggf@warning{Overfull \string\hbox\space (\the\pggf@tmplen\space too wide) in pggfplot row title "#1"}
		\fi
		\pggf@rowtitlefont\pgfmathsetlength{\pggf@tmplen}{\pgf@x - \pgflinewidth - (\pggf@rowtitlelines - .15) * \baselineskip - 2 * \pgfkeysvalueof{/pgf/inner ysep}}
		\ifdim0.0001pt<\pggf@tmplen\relax
			\pggf@warning{Overfull \string\vbox\space (\the\pggf@tmplen\space too high) in pggfplot row title "#1". Increase `row title lines`}
		\fi
	\fi
}


%%% configure ticks and ticklabels in facetted plots
\newcommand{\pggf@tickconfig}{
	\ifpggf@facetted%
		% determine relative facet position (0 = middle row, 1 = top row, 2 = bottom row, 3 = top + bottom row)
		\pggf@tmpct=0\relax
		\ifnum1=\pgfplots@group@current@row\relax% first row
			\advance\pggf@tmpct by1\relax
		\fi%
		\ifpggf@facet@wrap%
			\ifnum\pgfplots@group@current@plot>\numexpr\pggf@wrap@facets-\pggf@facetcols\relax% facets without a facet below
				\advance\pggf@tmpct by2\relax
			\fi%
		\else%
			\ifnum\pggf@facetrows=\pgfplots@group@current@row\relax% last row
				\advance\pggf@tmpct by2\relax					
			\fi%
		\fi%
		% store x tick label position in `\ifpggf@tmpif`: true = upper, false = lower
		\if u\pgfplots@xticklabel@pos\relax% upper
			\pggf@tmpiftrue%
		\else%
			\if l\pgfplots@xticklabel@pos\relax% lower
				\pggf@tmpiffalse%
			\else% default (`tick pos` decides)
				\ifnum3=\pgfplots@xtickposnum\relax% upper
					\pggf@tmpiftrue%
					\def\pgfplots@xticklabel@pos{u}%
				\else%
					\pggf@tmpiffalse%
					\def\pgfplots@xticklabel@pos{l}%
				\fi%
			\fi%
		\fi%
		% configure xlabels and x tick labels
		\pgfkeysalso{pggf inner x labels/.style = {}}
		\ifpggf@innerxlabels\else% no inner xlabels
			\pgfkeysalso{pggf inner x labels/.append style = {xlabel = {}}}
		\fi%
		\ifpggf@innerxticklabs\else% no inner x tick labels
			\pgfkeysalso{pggf inner x labels/.append style = {xticklabels = {}}}
		\fi%
		\ifnum2=\pgfplots@xaxislinesnum\relax\else% keep tick labels on zero line axis; potentially suppress others
			\ifcase\pggf@tmpct% middle row --> suppress
				\pgfkeysalso{pggf inner x labels}%
			\or% top row --> suppress if lower
				\ifpggf@tmpif\else%
					\pgfkeysalso{pggf inner x labels}%
				\fi%
			\or% bottom row --> suppress if upper
				\ifpggf@tmpif%
					\pgfkeysalso{pggf inner x labels}%
				\fi%
			\or% top + bottom row --> keep
			\fi%
		\fi%
		% configure x ticks
		\ifpggf@innerxticks\else% no inner x ticks
			\ifcase\pggf@tmpct% middle row
				\ifnum2=\pgfplots@xtickposnum\relax\else% keep ticks on zero line axis; suppress others
					\pgfkeysalso{xmajorticks = false, xminorticks = false}%
				\fi
			\or% top row
				\ifcase\pgfplots@xtickposnum\relax% both --> upper
					\def\pgfplots@xtickposnum{3}%
				\or% lower --> suppress
					\pgfkeysalso{xmajorticks = false, xminorticks = false}%
				\or% zero line --> keep
				\or% upper --> keep
				\else% suppress
					\pgfkeysalso{xmajorticks = false, xminorticks = false}%
				\fi%
			\or% bottom row
				\ifcase\pgfplots@xtickposnum\relax% both --> lower
					\def\pgfplots@xtickposnum{1}%
				\or% lower --> keep
				\or% zero line --> keep
				\or% upper --> suppress
					\pgfkeysalso{xmajorticks = false, xminorticks = false}%
				\fi%
			\or% top + bottom row --> keep
			\fi%
		\fi%
		% determine yticklabel position
		\if u\pgfplots@yticklabel@pos\relax%
			\pggf@tmpiftrue%
		\else%
			\if l\pgfplots@yticklabel@pos\relax%
				\pggf@tmpiffalse%
			\else%
				\ifnum2<\pgfplots@ytickposnum\relax%
					\pggf@tmpiftrue%
				\else%
					\pggf@tmpiffalse%
				\fi%
			\fi%
		\fi%
		% determine relative facet position (0 = middle column, 1 = top column, 2 = bottom column, 3 = top + bottom column)
		\pggf@tmpct=0\relax
		\ifnum1=\pgfplots@group@current@column\relax% first column
			\advance\pggf@tmpct by1\relax
		\fi%
		\ifnum\pggf@facetcols=\pgfplots@group@current@column\relax% last column
			\advance\pggf@tmpct by2\relax					
		\else%
			\ifpggf@facet@wrap%
				\ifnum\pgfplots@group@current@plot=\pggf@wrap@facets\relax% last wrap facet
					\advance\pggf@tmpct by2\relax
				\fi%
			\fi
		\fi%
		% store y tick label position in `\ifpggf@tmpif`: true = upper, false = lower
		\if u\pgfplots@yticklabel@pos\relax% upper
			\pggf@tmpiftrue%
		\else%
			\if l\pgfplots@yticklabel@pos\relax% lower
				\pggf@tmpiffalse%
			\else% default (`tick pos` decides)
				\ifnum3=\pgfplots@ytickposnum\relax% upper
					\pggf@tmpiftrue%
					\def\pgfplots@yticklabel@pos{u}%
				\else%
					\pggf@tmpiffalse%
					\def\pgfplots@yticklabel@pos{l}%
				\fi%
			\fi%
		\fi%
		% configure ylabels and y tick labels
		\pgfkeysalso{pggf inner y labels/.style = {}}
		\ifpggf@innerylabels\else% no inner ylabels
			\pgfkeysalso{pggf inner y labels/.append style = {ylabel = {}}}
		\fi%
		\ifpggf@inneryticklabs\else% no inner y tick labels
			\pgfkeysalso{pggf inner y labels/.append style = {yticklabels = {}}}
		\fi%
		\ifnum2=\pgfplots@yaxislinesnum\relax\else% keep tick labels on zero line axis; potentially suppress others
			\ifcase\pggf@tmpct% middle column --> suppress
				\pgfkeysalso{pggf inner y labels}%
			\or% left column --> suppress if upper
				\ifpggf@tmpif%
					\pgfkeysalso{pggf inner y labels}%
				\fi%
			\or% right column --> suppress if lower
				\ifpggf@tmpif\else%
					\pgfkeysalso{pggf inner y labels}%
				\fi%
			\or% left + right column --> keep
			\fi%
		\fi%
		% configure y ticks
		\ifpggf@inneryticks\else% no inner y ticks
			\ifcase\pggf@tmpct% middle column
				\ifnum2=\pgfplots@ytickposnum\relax\else% keep ticks on zero line axis; suppress others
					\pgfkeysalso{ymajorticks = false, yminorticks = false}%
				\fi
			\or% left column
				\ifcase\pgfplots@ytickposnum\relax% both --> lower
					\def\pgfplots@ytickposnum{1}%
				\or% lower --> keep
				\or% zero line --> keep
				\or% upper --> suppress
					\pgfkeysalso{ymajorticks = false, yminorticks = false}%
				\fi%
			\or% right column
				\ifcase\pgfplots@ytickposnum\relax% both --> upper
					\def\pgfplots@ytickposnum{3}%
				\or% lower --> suppress
					\pgfkeysalso{ymajorticks = false, yminorticks = false}%
				\or% zero line --> keep
				\or% upper --> keep
				\else% suppress
					\pgfkeysalso{ymajorticks = false, yminorticks = false}%
				\fi%
			\or% left + right column --> keep
			\fi%
		\fi%
	\fi%
}

%%% pgfplots styles to set axis limits (and other options) from a file
\pgfplotsset{
	axis option from table line/.code n args = {3}{
		\pgfplotstablegetelem{#3}{#1}\of{#2}%
		\pgfkeysalso{axis@options/.append style/.expanded = {#1 = {\pgfplotsretval}}}%
	},
	axis options from table/.code = {
		\pgfplotstable@isloadedtable{#1}%
			{\pgfplotstablecopy{#1}\to\axes@datatable}%
			{\pgfplotstableread[col sep = tab]{#1}\axes@datatable}%
		\pgfplotstableforeachcolumn{\axes@datatable}\as{\colname}{%
			\pgfkeysalso{axis option from table line/.expand once = {\colname}{\axes@datatable}{0}}%
		}%
		\pgfkeysalso{axis@options}%
		% configure ticks and tick labels
		\pggf@tickconfig%
	},
	axis@options/.style = {},
}


%%% option to display the origin as "0" independent of the formatting of the other ticks
\def\pggf@zerotickformat{}

\pgfplotsset{
	origin as zero/.is choice,
	origin as zero/true/.code = {%
		\def\pggf@zerotickformat{%
			\pgfmathfloatifapproxequalrel{\tick}{0}{\pgfkeys{/pgf/number format/int trunc}\def\tick{0}}{}%
		}%
	},
	origin as zero/false/.code = {%
		\def\pggf@zerotickformat{}%
	},
	origin as zero/.default = true
}

\patchcmd{\pgfplots@show@ticklabel@@}{%
	\node at (\pgfplots@ticklabel@at@x,\pgfplots@ticklabel@at@y) {\csname pgfplots@#1ticklabel\endcsname};%
}{%
	\node at (\pgfplots@ticklabel@at@x,\pgfplots@ticklabel@at@y) {\pggf@zerotickformat\csname pgfplots@#1ticklabel\endcsname};%
}{%
	% success
}{%
	\pggf@warning{The key `origin as zero` is no longer working because the command `\string\pgfplots@show@ticklabel@@` cannot be patched.}%
}


