% set up pgfplots styles
\pgfplotsset{
	every facet/.style ={
		/pggf/@coltitles,
		/pggf/@rowtitles
	},
	facet 1/.style = {},
	column 1/.style = {},
	row 1/.style = {},
	pggfplot/.append style = {
		enlargelimits = 0,
		extra description/.append code = {
			\ifpggf@tight@x\else
				\path (-\pggf@ylabelwidth, 0);
			\fi
			\ifpggf@tight@y\else
				\path (0, -\pggf@xlabelheight);
			\fi
		}
	},
	pggfplot position/.style = {},
	scale facet width/.store in = \pggf@scalewidth,
	scale facet height/.store in = \pggf@scaleheight,
	scale axes/.code = {
		\pgfluamathsetmacro{\pggf@tmp}{\pggfxmax - \pggfxmin}
		\pgfluamathsetmacro{\pggf@enlarge@x@lower}{\pggf@enlarge@x@lower + \pggf@enlarge@x@abslower / \pggf@tmp}
		\pgfluamathsetmacro{\pggf@enlarge@x@upper}{\pggf@enlarge@x@upper + \pggf@enlarge@x@absupper / \pggf@tmp}
		\pgfkeysalso{xmin/.expanded = {\pggfxmin - \pggf@enlarge@x@lower * \pggf@tmp}, xmax/.expanded = {\pggfxmax + \pggf@enlarge@x@upper * \pggf@tmp}}
		\pgfluamathsetmacro{\pggf@tmp}{\pggfymax - \pggfymin}
		\pgfluamathsetmacro{\pggf@enlarge@y@lower}{\pggf@enlarge@y@lower + \pggf@enlarge@y@abslower / \pggf@tmp}
		\pgfluamathsetmacro{\pggf@enlarge@y@upper}{\pggf@enlarge@y@upper + \pggf@enlarge@y@absupper / \pggf@tmp}
		\pgfkeysalso{ymin/.expanded = {\pggfymin - \pggf@enlarge@y@lower * \pggf@tmp}, ymax/.expanded = {\pggfymax + \pggf@enlarge@y@upper * \pggf@tmp}}
	},
	hexbin width/.store in = \pggf@hexbin@width,
	hexbin shape/.store in = \pggf@hexbin@shape,
}

