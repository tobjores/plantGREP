%%% warnings from pggfplot package (warning will also be added to the .dpth file if image is being externalized)
\newcommand{\pggf@warning}[1]{%
	\PackageWarning{pggfplot}{#1}%
	\ifcsname tikz@library@external@loaded\endcsname%
		\tikzifexternalizing{\pgfexternalstorecommand{\string\PackageWarning{pggfplot}{#1}}}{}%
	\fi%
}


%%% process package options
\def\pggf@opts@color{0}
\def\pggf@opts@cyclelist{0}

\pgfkeys{
	/pggfplot/.cd,
	colors/.is choice,
	colors/none/.code = {\def\pggf@opts@color{-1}},% don't define any colors
	colors/all/.code = {\def\pggf@opts@color{0}},% define OkabeIto and all PaulTol* colors 
	colors/all*/.code = {\def\pggf@opts@color{1}},% as all but uses the alternative OkabeIto* colors
	colors/OkabeIto/.code = {\def\pggf@opts@color{2}},% define OkabeIto colors
	colors/OkabeIto*/.code = {\def\pggf@opts@color{3}},% define OkabeIto* colors (uses a darker yellow as OkabeIto5 for easier visibility)
	colors/PaulTolBright/.code = {\def\pggf@opts@color{4}},% define PaulTolBright colors
	colors/PaulTolVibrant/.code = {\def\pggf@opts@color{5}},% define PaulTolVibrant colors
	colors/PaulTolMuted/.code = {\def\pggf@opts@color{6}},% define PaulTolMuted colors
	colors/PaulTolLight/.code = {\def\pggf@opts@color{7}},% define PaulTolLight colors
	colors/PaulTol/.code = {\def\pggf@opts@color{8}},% define all PaulTol* colors
	cyclelist/.is choice,
	cyclelist/none/.code = {\def\pggf@opts@cyclelist{-1}}, % don't set any plotcyclelist
	cyclelist/auto/.code = {\def\pggf@opts@cyclelist{0}},% automatically determine the plotcyclelist to use: no list for `colors=none`, OkabeIto(*) for `colors=all(*)`, PaulTolLight for `colors=PaulTol`, and the corresponding list for all other `color` keys
	cyclelist/OkabeIto/.code = {\def\pggf@opts@cyclelist{1}},% use OkabeIto as plotcyclelist
	cyclelist/PaulTolBright/.code = {\def\pggf@opts@cyclelist{2}},% use PaulTolBright as plotcyclelist
	cyclelist/PaulTolVibrant/.code = {\def\pggf@opts@cyclelist{3}},% use PaulTolVibrant as plotcyclelist
	cyclelist/PaulTolMuted/.code = {\def\pggf@opts@cyclelist{4}},% use PaulTolMuted as plotcyclelist
	cyclelist/PaulTolLight/.code = {\def\pggf@opts@cyclelist{5}},% use PaulTolLight as plotcyclelist
}

