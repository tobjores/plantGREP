%%% light
\newcommand{\plic@light}[1]{
	\coordinate (light@center) at (#1);
	\begin{scope}[shift = {(#1)}, scale = \plic@scale, rotate around = {\plic@rotate:(light@center)}]
		\useasboundingbox (light@center) +(1, 1) rectangle +(-1, -1);
		\fill[plic@light] (light@center) circle (0.5);
		\foreach \x in {1, ..., 6}{
			\draw[plic@light, line width = 2.5pt * \plic@scale, line cap = round] (light@center) ++(30 + 60 * \x: 0.6) -- ++(30 + 60 * \x: 0.35);
			\draw[plic@light, line width = 2pt * \plic@scale, line cap = round] (light@center) ++(60 * \x: 0.65) -- ++(60 * \x: 0.25);
		}
	\end{scope}
}

\definecolor{plic@light}{HTML}{ffb90f}

\plic@set{size/light/.code = {\def\plic@width{2cm}\def\plic@height{2cm}}}


%%% dark
\newcommand{\plic@dark}[1]{
	\coordinate (dark@center) at (#1);
	\begin{scope}[shift = {(#1)}, scale = \plic@scale, rotate around = {\plic@rotate:(dark@center)}, even odd rule]
		\useasboundingbox (dark@center) +(1, 1) rectangle +(-1, -1);
		\clip (dark@center) +(.4, .2) circle (.8) +(-1, 1) rectangle +(1, -1);
		\fill[plic@dark] (dark@center) circle (1);
	\end{scope}
}

\definecolor{plic@dark}{HTML}{bbbbbb}

\plic@set{size/dark/.code = {\def\plic@width{2cm}\def\plic@height{2cm}}}


%%% cold
\newcommand{\plic@cold}[1]{
	\coordinate (cold@center) at (#1);
	\begin{scope}[shift = {(#1)}, scale = \plic@scale, rotate around = {\plic@rotate:(cold@center)}, even odd rule]
		\useasboundingbox (cold@center) +(1, 1) rectangle +(-1, -1);
		\fill[plic@cold] (cold@center) ++(0, -0.665) ++(120: 0.3) arc [start angle = 120, delta angle = 300, radius = 0.3cm] coordinate (c1) -- ++(0, 0.3) -| cycle;
		\draw[black, line width = 1pt * \plic@scale] (cold@center) ++(0, -0.665) ++(120: 0.3) arc [start angle = 120, delta angle = 300, radius = 0.3cm] coordinate (c1) -- ++(0, 1.22) coordinate (c2) arc [start angle = 0, delta angle = 180, radius = 0.15cm] -- cycle;
		\foreach \x in {1, ..., 6}{
			\draw[black, line width = 0.75pt * \plic@scale, line cap = round] ($(c1)!\x/8!(c2)$) -- ++(-.12, 0);
		}
	\end{scope}
}

\definecolor{plic@cold}{HTML}{00bfff}

\plic@set{size/cold/.code = {\def\plic@width{0.67cm}\def\plic@height{2cm}}}


